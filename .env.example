# Copy to .env.local for local development. In Vercel, set these under
# Project Settings > Environment Variables and mark the secret ones "Sensitive".

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret, server only

# OpenAI: use a key from a dedicated "lingo-ai" project with a budget limit set
OPENAI_API_KEY=                       # secret, server only

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TRANSCRIPT_ENCRYPTION_KEY=            # secret, server only

APP_URL=http://localhost:3000

# Optional overrides (defaults shown)
# REALTIME_MODEL=gpt-realtime-2.1-mini
# TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# DAILY_LIMIT_MINUTES=15
# MAX_SESSION_MINUTES=10
# MONTHLY_BUDGET_USD=50
# BUDGET_BLOCK_RATIO=0.9
# RESERVE_USD_PER_MINUTE=0.1

# Emails allowed into internal tools (comma separated), e.g. /app/voices
ADMIN_EMAILS=

# Optional: enables /api/admin/persona-test on Preview
PERSONA_TEST_KEY=
